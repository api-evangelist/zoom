          "name": "Zoom Get Meeting Recordings",
          "request": {
            "name": "Zoom Get Meeting Recordings",
            "description": {
              "content": "Retrieve all recordings for a specific meeting. Cloud recordings are available to paid accounts with cloud recording enabled.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "meetings",
                ":meetingId",
                "recordings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include_fields",
                  "value": "<string>",
                  "description": "Additional fields to include in the response."
                },
                {
                  "disabled": false,
                  "key": "ttl",
                  "value": "<integer>",
                  "description": "Time to live in seconds for the download URL."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "meetingId",
                  "description": "(Required) The meeting ID. This can be the meeting number (e.g., 85746065) or the meeting UUID."
                }
              ]
