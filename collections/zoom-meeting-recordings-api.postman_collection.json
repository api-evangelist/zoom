        {
          "id": "6b76c6d3-e26c-493a-ac63-998786c7ca16",
          "name": "Zoom Delete Meeting Recordings",
          "request": {
            "name": "Zoom Delete Meeting Recordings",
            "description": {
              "content": "Delete all recording files of a meeting. The recording files will be moved to trash and permanently deleted after 30 days.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "meetings",
                ":meetingId",
                "recordings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "action",
                  "value": "trash",
                  "description": "Delete action. `trash` moves to trash. `delete` permanently deletes."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "meetingId",
                  "description": "(Required) The meeting ID. This can be the meeting number (e.g., 85746065) or the meeting UUID."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null
          },
