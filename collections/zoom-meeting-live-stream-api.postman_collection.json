        {
          "id": "564ffcfc-da0d-45da-b602-bdab6c1a7e79",
          "name": "Zoom Update a Live Stream",
          "request": {
            "name": "Zoom Update a Live Stream",
            "description": {
              "content": "Update the live stream configuration of a meeting. The meeting host must configure live streaming settings before the meeting starts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "meetings",
                ":meetingId",
                "livestream"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "meetingId",
                  "description": "(Required) The meeting ID. This can be the meeting number (e.g., 85746065) or the meeting UUID."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stream_url\": \"<uri>\",\n  \"stream_key\": \"<string>\",\n  \"page_url\": \"<uri>\",\n  \"resolution\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
