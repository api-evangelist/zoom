          "name": "Zoom Update Live Stream Status",
          "request": {
            "name": "Zoom Update Live Stream Status",
            "description": {
              "content": "Update the status of a live stream during a meeting. Use this to start or stop live streaming.",
              "type": "text/plain"
            },
