{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zoom / Account Report API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Report",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "reportGetaccountreport",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zoom.us/v1/report/getaccountreport",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "from",
                  "value": ""
                },
                {
                  "name": "to",
                  "value": ""
                },
                {
                  "name": "page_size",
                  "value": ""
                },
                {
                  "name": "page_number",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Get account report for a specified period.\n\n"
        },
        {
          "info": {
            "name": "reportGetaudioreport",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zoom.us/v1/report/getaudioreport",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "from",
                  "value": ""
                },
                {
                  "name": "to",
                  "value": ""
                },
                {
                  "name": "type",
                  "value": ""
                },
                {
                  "name": "page_size",
                  "value": ""
                },
                {
                  "name": "page_number",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Get user report for a specified period.\n\n<aside class=\"notice\">Toll Report API is provided for enabled 'Toll Report' option.</aside>\n\n<aside class=\"notice\">We will report a maximum of one month. For example, if \"from\" is set to \"2015-08-05\" and \"to\" is \"2015-10-10\" we will adjust \"from\" to \"2015-09-10\"</aside>\n\n"
        },
        {
          "info": {
            "name": "reportGetdailyreport",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zoom.us/v1/report/getdailyreport",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "year",
                  "value": ""
                },
                {
                  "name": "month",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Get daily report for one month, can only get daily report for recent 3 months.\n\n"
        },
        {
          "info": {
            "name": "reportGetuserreport",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zoom.us/v1/report/getuserreport",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "user_id",
                  "value": ""
                },
                {
                  "name": "from",
                  "value": ""
                },
                {
                  "name": "to",
                  "value": ""
                },
                {
                  "name": "page_size",
                  "value": ""
                },
                {
                  "name": "page_number",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Get user report for a specified period.\n\n"
        }
      ]
    }
  ],
  "bundled": true
}